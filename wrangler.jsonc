{
  // Configuration Cloudflare Workers — Digital Visual Studio
  // Documentation : https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digital-visual-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",

  // Fichiers statiques du site (HTML / CSS / JS / images)
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Ces routes sont toujours traitées par le Worker (API + médias uploadés)
    "run_worker_first": ["/api/*", "/media/*"]
  },

  // Base de données D1 : services + réalisations (portfolio)
  // Pas d'ID : wrangler crée (ou retrouve) automatiquement la base
  // nommée "dvs-database" sur le compte au moment du déploiement,
  // et le Worker crée lui-même ses tables au premier appel.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dvs-database"
    }
  ],

  // Stockage KV : images uploadées depuis l'espace admin
  // Pas d'ID : créé automatiquement au premier déploiement,
  // puis réutilisé aux déploiements suivants.
  "kv_namespaces": [
    {
      "binding": "MEDIA"
    }
  ],

  "observability": {
    "enabled": true
  }

  // ⚠️ SECRET À CONFIGURER (ne jamais le mettre dans ce fichier !) :
  //   ADMIN_PASSWORD — mot de passe de l'espace administrateur
  // En ligne de commande :  npx wrangler secret put ADMIN_PASSWORD
  // Ou dans le dashboard : Workers & Pages → digital-visual-studio →
  //   Settings → Variables and Secrets → Add → Type "Secret"
}
